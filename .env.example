# Keep real credentials in the deployment environment or .env.local.
# Never commit real Zoho credentials.
ZOHO_CLIENT_ID=replace_me
ZOHO_CLIENT_SECRET=replace_me
ZOHO_REFRESH_TOKEN=replace_me

# The credentials supplied for this project use the US data center.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com

# Both values are required before the server can contact Zoho.
ZOHO_LEAD_SUBMISSION_ENABLED=false
ZOHO_LIVE_CONFIRMATION=
